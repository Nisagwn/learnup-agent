# Supabase — Firebase'in yerini alan backend.
# Değerleri Supabase Dashboard → Project Settings → API'den al.
# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir (git'e .env'i EKLEME).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# AI backend (Supabase Edge Function) — deploy sonrası buraya yazılır.
# Örn: https://YOUR_PROJECT_REF.functions.supabase.co
VITE_EDGE_FUNCTIONS_BASE_URL=
