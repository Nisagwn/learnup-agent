# frontend-v2 — TARAYICIYA GÖMÜLÜR (VITE_*). Buraya YALNIZ public anahtar koy.
# ⚠️ service-role (sb_secret_...) ASLA buraya girmez — o yalnız learnup-brain/.env'de.

# Supabase (kimlik). Eski frontend/.env ile AYNI proje/anahtar kullan (aynı kullanıcılar).
VITE_SUPABASE_URL=https://<proj>.supabase.co
VITE_SUPABASE_ANON_KEY=<sb_publishable_...>

# Backend (learnup-brain). Boşsa '/api' kullanılır (vite proxy → :8080). Normalde boş bırak.
# VITE_API_URL=/api
