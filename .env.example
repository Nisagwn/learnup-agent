# LearnUp TAM STACK — kök compose için BUILD-time değişkenler (yalnız frontend).
# Bu dosyayı .env olarak kopyala:  cp .env.example .env
#
# ⚠️ Buraya YALNIZ PUBLIC değerler girer (Vite bunları tarayıcı bundle'ına gömer).
#    service_role / sb_secret ASLA burada olmaz — o yalnız learnup-brain/.env'de kalır.
#
# Değerler frontend/.env ile AYNI (Supabase Dashboard → Project Settings → API).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Opsiyonel — eski Edge Function tabanı (invoke→fetch göçüne kadar kullanılıyorsa).
VITE_EDGE_FUNCTIONS_BASE_URL=
