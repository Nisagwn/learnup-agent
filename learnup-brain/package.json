{
  "name": "learnup-brain",
  "version": "0.1.0",
  "description": "LearnUp YKS 'beyin' mikroservisi — Chatbot, Ajan Orkestrasyonu, OpenRouter/DeepSeek ve Supabase pgvector RAG (Bun + TypeScript, bağımsız).",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:worker": "bun --watch src/workers/atolye.worker.ts",
    "start": "bun src/server.ts",
    "start:worker": "bun src/workers/atolye.worker.ts",
    "seed": "bun src/scripts/seed-data.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "eval": "bun src/scripts/eval.ts",
    "etiketle": "bun src/scripts/etiketle-cikmis.ts",
    "etiket-yaz": "bun src/scripts/etiket-yaz.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.3",
    "katex": "^0.16.45",
    "openai": "^4.68.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  }
}
