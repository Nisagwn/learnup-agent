# bağımlılıklar
node_modules/

# derleme çıktısı
dist/

# ORTAM (SECRET — service-role key, JWT secret, API anahtarları)
#
# ⚠️ ÖNCE HER .env* YOK SAYILIR, SONRA yalnız .env.example geri alınır.
# Eski liste (.env / .env.local / .env.*.local) yalnız ÜÇ ADI kapsıyordu ve
# `.env.bak-anthropic` bu ağdan kaçıyordu — içinde SUPABASE_SERVICE_ROLE_KEY,
# OPENROUTER/OPENAI/ANTHROPIC anahtarları olan gerçek bir yedek. `git add .`
# onu commit'e alırdı; GitHub'a giden anahtar geri alınamaz (anında taranır).
# Beyaz liste yaklaşımı: yeni bir yedek adı uydurulsa bile ağa takılır.
.env*
!.env.example

# loglar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# işletim sistemi / editör
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# test / coverage
coverage/
.nyc_output/

# ── VERİ (data/) ─────────────────────────────────────────────────────────────
# Kaynak belgeler: MEB DÖP müfredat PDF'leri + ÖSYM çıkmış soru kitapçıkları.
# ~190 MB. Repo'ya girerse her klon bunu indirir ve git geçmişinden bir daha
# çıkmaz. Yayımcısından yeniden indirilebilir; türevleri (data/*.json) izleniyor.
data/pdf/
data/questions/
*.pdf

# pdftotext ara çıktıları (PDF'ten saniyeler içinde yeniden üretilir)
data/**/*.txt

# Embedding önbelleği — 37 MB, TÜREV. Eşik ayarlarken script'i defalarca
# çalıştırmak için var; silinirse ingest yeniden embed eder (API maliyeti düşük).
data/.sorular-vec.json

# ingest-sorular'ın her koşuda yeniden yazdığı denetim raporu (elle eşlemenin
# başlangıç noktasıydı; artık konu-kazanim.json otorite — bu sadece çıktı).
data/konu-kazanim-oto.json
eval-sonuclari/
data/uretim-hata/
data/*.log
data/ab-*.json

# Etiketleme checkpoint çıktısı — TÜREV veri, script yeniden üretir.
data/*.jsonl
