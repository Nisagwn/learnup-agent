# LearnUp "beyin" mikroservisi — ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur. `.env` ASLA commit edilmez.

PORT=8080
NODE_ENV=development

# ── Supabase (veri + hafıza deposu) ─────────────────────────────────────
SUPABASE_URL=https://<proj>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>    # RLS'i baypas eder → YALNIZ sunucu, ASLA istemciye verme
SUPABASE_JWT_SECRET=<supabase-jwt-secret>       # Lokal JWT doğrulama (Dashboard > Settings > API > JWT Secret)

# ── LLM: chat/completions → OpenRouter (DeepSeek) ───────────────────────
OPENROUTER_API_KEY=<openrouter-key>

# ── Embeddings: YALNIZ text-embedding-3-small @768 → DOĞRUDAN OpenAI ─────
# OpenRouter embeddings sunmaz/sınırlıdır (F2). Bu anahtar yalnızca embedding içindir.
OPENAI_API_KEY=<openai-key-sadece-embedding>

# ── Redis (hot-path; ajan orkestrasyonu — opsiyonel, agents/worker fazında gerekir) ──
REDIS_URL=redis://localhost:6379

# İstemci/attribution URL'i (OpenRouter HTTP-Referer başlığı)
APP_URL=https://learnup.app
